# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Payment Gateway Configuration (Razorpay / Stripe)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_tots_key_123456
RAZORPAY_KEY_SECRET=rzp_secret_tots_secret_789012
RAZORPAY_WEBHOOK_SECRET=whsec_tots_webhook_secret

# Store & Email Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_123456789
EMAIL_FROM=orders@totsfashion.com

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Admin Authentication
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SESSION_SECRET=your_random_secret_key_or_leave_blank_for_fallback


# Instagram oEmbed API (Optional — for reliable embed thumbnails)
# Get from: https://developers.facebook.com/tools/explorer/
# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_
INSTAGRAM_OEMBED_ACCESS_TOKEN=your_facebook_app_access_token_here
